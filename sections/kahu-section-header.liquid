{%- comment -%}
  Kahu section header: reusable intro row used above content sections
  (Figma: Benefits 723:75, Size 723:104, Occasions 723:167, Promo packs 752:15335).
  Spec: handoff/004-section-header-and-columns.md
  - Everything is a block: Eyebrow, Title, Text, Button, Image, Divider.
  - Eyebrow / Title / Text / Button / Image each choose the LEFT or RIGHT column.
    Figma pattern: eyebrow + title + text on the left, button (or an image) on the right, 1px rule underneath.
  - Divider block always spans the full width, wherever it sits in the block list.
  - Spacing (padding + margin) set separately for desktop and mobile.
{%- endcomment -%}

{{ 'kahu-section-header.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign s = section.settings

  case s.bg_color
    when 'custom'
      assign bg = s.bg_color_custom
    when 'transparent'
      assign bg = 'transparent'
    else
      assign bg = 'var(--kahu-' | append: s.bg_color | append: ')'
  endcase

  if s.text_color == 'custom'
    assign fg = s.text_color_custom
  else
    assign fg = 'var(--kahu-' | append: s.text_color | append: ')'
  endif

  assign has_right = false
  for block in section.blocks
    if block.settings.column == 'right'
      assign has_right = true
      break
    endif
  endfor
-%}

{%- style -%}
  #kahu-sh-{{ section.id }} {
    --ksh-bg: {{ bg }};
    --ksh-fg: {{ fg }};
    --ksh-pt: {{ s.mobile_padding_top }}px;
    --ksh-pb: {{ s.mobile_padding_bottom }}px;
    --ksh-mt: {{ s.mobile_margin_top }}px;
    --ksh-mb: {{ s.mobile_margin_bottom }}px;
  }
  @media (min-width: 750px) {
    #kahu-sh-{{ section.id }} {
      --ksh-pt: {{ s.desktop_padding_top }}px;
      --ksh-pb: {{ s.desktop_padding_bottom }}px;
      --ksh-mt: {{ s.desktop_margin_top }}px;
      --ksh-mb: {{ s.desktop_margin_bottom }}px;
    }
  }
{%- endstyle -%}

{%- capture left_col -%}
  {%- for block in section.blocks -%}
    {%- if block.type != 'divider' and block.settings.column != 'right' -%}
      {%- render 'kahu-section-header-block', block: block -%}
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}

{%- capture right_col -%}
  {%- for block in section.blocks -%}
    {%- if block.type != 'divider' and block.settings.column == 'right' -%}
      {%- render 'kahu-section-header-block', block: block -%}
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}

<div id="kahu-sh-{{ section.id }}" class="kahu-sh">
  <div class="kahu-sh__inner{% unless s.full_width %} kahu-sh__inner--contained{% endunless %}">
    <div class="kahu-sh__row kahu-sh__row--align-{{ s.right_align }}{% if has_right and s.layout != 'center' %} kahu-sh__row--split{% endif %}{% if s.layout == 'center' %} kahu-sh__row--center{% endif %}">
      {%- if left_col != blank -%}
        <div class="kahu-sh__col kahu-sh__col--left">{{ left_col }}</div>
      {%- endif -%}
      {%- if right_col != blank -%}
        <div class="kahu-sh__col kahu-sh__col--right">{{ right_col }}</div>
      {%- endif -%}
    </div>

    {%- for block in section.blocks -%}
      {%- if block.type == 'divider' -%}
        {%- liquid
          if block.settings.color == 'custom'
            assign line = block.settings.color_custom
          elsif block.settings.color == 'current'
            assign line = 'currentColor'
          else
            assign line = 'var(--kahu-' | append: block.settings.color | append: ')'
          endif
        -%}
        <hr
          class="kahu-sh__divider"
          style="--ksh-line: {{ line }}; --ksh-line-w: {{ block.settings.thickness }}px; --ksh-line-gap-d: {{ block.settings.space_desktop }}px; --ksh-line-gap-m: {{ block.settings.space_mobile }}px;"
          {{ block.shopify_attributes }}
        >
      {%- endif -%}
    {%- endfor -%}
  </div>
</div>

