{%- comment -%}
  Kahu reviews: "Kahu happy customers" (Figma 723:191).
  Photo background + overlay, intro (header blocks) on the left, scrolling review cards on the right.
  Cards come live from Judge.me (featured reviews, public token) via assets/kahu-reviews.js.
  "Review" blocks are the fallback shown if Judge.me is off/unavailable (and the source when set to Manual).
  Also accepts header blocks and a Kahu separator block, like Kahu columns.
{%- endcomment -%}

{{ 'kahu-reviews.css' | asset_url | stylesheet_tag }}
{{ 'kahu-section-header.css' | asset_url | stylesheet_tag }}
{{ 'kahu-separator.css' | asset_url | stylesheet_tag }}
<script src="{{ 'kahu-reviews.js' | asset_url }}" defer></script>

{%- liquid
  assign s = section.settings
  case s.bg_color
    when 'custom'
      assign bg = s.bg_color_custom
    when 'transparent'
      assign bg = 'transparent'
    else
      assign bg = 'var(--kahu-' | append: s.bg_color | append: ')'
  endcase
  if s.text_color == 'custom'
    assign fg = s.text_color_custom
  else
    assign fg = 'var(--kahu-' | append: s.text_color | append: ')'
  endif
  if s.card_bg == 'custom'
    assign card_bg = s.card_bg_custom
  else
    assign card_bg = 'var(--kahu-' | append: s.card_bg | append: ')'
  endif
  if s.card_fg == 'custom'
    assign card_fg = s.card_fg_custom
  else
    assign card_fg = 'var(--kahu-' | append: s.card_fg | append: ')'
  endif
-%}

{%- style -%}
  #kahu-rv-{{ section.id }} {
    --kr-bg: {{ bg }};
    --kr-fg: {{ fg }};
    --kr-head-fg: {{ fg }};
    --kr-overlay: {{ s.overlay | divided_by: 100.0 }};
    --kr-card-bg: {{ card_bg }};
    --kr-card-fg: {{ card_fg }};
    --kr-star: var(--kahu-{{ s.star_color }});
    --kr-name: var(--kahu-{{ s.name_color }});
    --kr-card-w: {{ s.card_width }}px;
    --kr-card-w-m: {{ s.card_width_mobile }}%;
    --kr-card-h: {{ s.card_min_height }}px;
    --kr-card-pad: {{ s.card_padding }}px;
    --kr-radius: {{ s.card_radius }}px;
    --kr-gap: {{ s.card_gap }}px;
    --kr-quote-d: {{ s.quote_size }}px;
    --kr-quote-m: {{ s.quote_size_mobile }}px;
    --kr-intro-w: {{ s.intro_width }}px;
    --kr-align: {{ s.align }};
    --kr-col-gap-d: {{ s.column_gap }}px;
    --kr-pt: {{ s.mobile_padding_top }}px;
    --kr-pb: {{ s.mobile_padding_bottom }}px;
    --kr-mt: {{ s.mobile_margin_top }}px;
    --kr-mb: {{ s.mobile_margin_bottom }}px;
  }
  @media (min-width: 750px) {
    #kahu-rv-{{ section.id }} {
      --kr-pt: {{ s.desktop_padding_top }}px;
      --kr-pb: {{ s.desktop_padding_bottom }}px;
      --kr-mt: {{ s.desktop_margin_top }}px;
      --kr-mb: {{ s.desktop_margin_bottom }}px;
    }
  }
{%- endstyle -%}

<kahu-reviews
  id="kahu-rv-{{ section.id }}"
  class="kahu-rv kahu-rv--{{ s.layout }}"
  data-source="{{ s.source }}"
  data-token="{{ s.judgeme_token | escape }}"
  data-shop="{{ shop.permanent_domain }}"
  data-max="{{ s.max_reviews }}"
  data-min-stars="{{ s.min_stars }}"
  data-min-chars="{{ s.min_chars }}"
  data-attribution="{{ s.attribution }}"
  data-label="{{ s.label | escape }}"
  data-show-title="{{ s.show_title }}"
  data-show-product="{{ s.show_product }}"
  data-show-date="{{ s.show_date }}"
>
  {%- if s.bg_image -%}
    <div class="kahu-rv__bg" aria-hidden="true">
      <picture>
        {%- if s.bg_image_mobile -%}
          <source media="(max-width: 749px)" srcset="{{ s.bg_image_mobile | image_url: width: 750 }} 750w, {{ s.bg_image_mobile | image_url: width: 1100 }} 1100w, {{ s.bg_image_mobile | image_url: width: 1500 }} 1500w" sizes="100vw">
        {%- endif -%}
        {{ s.bg_image | image_url: width: 2880 | image_tag: widths: '750, 1100, 1440, 1920, 2880', sizes: '100vw', loading: 'lazy', alt: '' }}
      </picture>
      <span class="kahu-rv__overlay"></span>
    </div>
  {%- endif -%}

  {%- for block in section.blocks -%}
    {%- if block.type == 'separator' and block.settings.position == 'top' -%}
      {%- capture graphics -%}
        {%- if block.settings.g1_image -%}{%- render 'kahu-separator-graphic', g: block.settings, prefix: 'g1_' -%}{%- endif -%}
        {%- if block.settings.g2_image -%}{%- render 'kahu-separator-graphic', g: block.settings, prefix: 'g2_' -%}{%- endif -%}
      {%- endcapture -%}
      {%- render 'kahu-separator-body', s: block.settings, id: block.id, graphics: graphics, attrs: block.shopify_attributes -%}
    {%- endif -%}
  {%- endfor -%}

  <div class="kahu-rv__body">
    <div class="kahu-rv__inner">
      {%- capture header_row -%}
        {%- render 'kahu-header-row', blocks: section.blocks, layout: 'stack', right_align: 'start' -%}
      {%- endcapture -%}
      {%- if header_row != blank -%}
        <div class="kahu-rv__intro">{{ header_row }}</div>
      {%- endif -%}

      <div class="kahu-rv__cards">
        <ul class="kahu-rv__track" role="list" data-kr-track aria-label="{{ s.aria_label | escape }}">
          {%- for block in section.blocks -%}
            {%- if block.type != 'review' -%}{%- continue -%}{%- endif -%}
            {%- assign r = block.settings -%}
            <li class="kahu-rv__card" {{ block.shopify_attributes }}>
              <div class="kahu-rv__stars" role="img" aria-label="{{ r.stars }} out of 5 stars">
                {%- for i in (1..5) -%}{%- if i <= r.stars -%}★{%- else -%}☆{%- endif -%}{%- endfor -%}
              </div>
              {%- if r.title != blank -%}<p class="kahu-rv__title">{{ r.title | escape }}</p>{%- endif -%}
              <p class="kahu-rv__quote">“{{ r.quote | escape }}”</p>
              <div class="kahu-rv__meta">
                <span class="kahu-rv__name">{{ r.name | default: s.label | escape }}</span>
                {%- if r.product != blank -%}<span class="kahu-rv__product">{{ r.product | escape }}</span>{%- endif -%}
              </div>
            </li>
          {%- endfor -%}
        </ul>

        {%- if s.show_arrows -%}
          <div class="kahu-rv__arrows">
            <button type="button" class="kahu-rv__arrow" data-kr-prev aria-label="Previous reviews">
              <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M14.5 5.5L8 12l6.5 6.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
            <button type="button" class="kahu-rv__arrow" data-kr-next aria-label="Next reviews">
              <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M9.5 5.5L16 12l-6.5 6.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
          </div>
        {%- endif -%}

        <template data-kr-card>
          <li class="kahu-rv__card">
            <div class="kahu-rv__stars" role="img" data-kr-stars><span data-kr-stars-text></span></div>
            <p class="kahu-rv__title" data-kr-title></p>
            <p class="kahu-rv__quote" data-kr-body></p>
            <div class="kahu-rv__meta">
              <span class="kahu-rv__name" data-kr-name></span>
              <span class="kahu-rv__product" data-kr-product></span>
              <span class="kahu-rv__date" data-kr-date></span>
            </div>
          </li>
        </template>
      </div>
    </div>
  </div>

  {%- for block in section.blocks -%}
    {%- if block.type == 'separator' and block.settings.position == 'bottom' -%}
      {%- capture graphics -%}
        {%- if block.settings.g1_image -%}{%- render 'kahu-separator-graphic', g: block.settings, prefix: 'g1_' -%}{%- endif -%}
        {%- if block.settings.g2_image -%}{%- render 'kahu-separator-graphic', g: block.settings, prefix: 'g2_' -%}{%- endif -%}
      {%- endcapture -%}
      {%- render 'kahu-separator-body', s: block.settings, id: block.id, graphics: graphics, attrs: block.shopify_attributes -%}
    {%- endif -%}
  {%- endfor -%}
</kahu-reviews>

