{%- comment -%}
  Kahu columns: reusable multi-column cards, every column is a block.
  Figma uses: Benefits 723:75 (image + sticker + title below), Size cards 723:104 (logo + name + fit text + button
  inside the image), Occasions 723:167 (image + rotated sticker + title below), Kahu TV, etc.
  Spec: handoff/004-section-header-and-columns.md
  Each Column block can use any mix of:
    - Image (desktop + mobile), own shape, overlay gradient, whole-card link
    - Sticker graphic on top (position, size, rotation)
    - Inside-image content: logo, title, text (position + colour)
    - Below-image content: title, text
    - Button: inside the image or below it
  Blank fields are simply not shown, so a column can be image-only.
  Everything else for the band is a block too:
    - Header blocks (eyebrow, title, text, button, image/icon, social links, divider line) → row above the cards
    - Kahu separator block → curve at the top or bottom of this section (with up to 2 graphics)
  So one section = one design band (saves Shopify's 25-sections-per-page limit).
{%- endcomment -%}

{{ 'kahu-columns.css' | asset_url | stylesheet_tag }}
{{ 'kahu-section-header.css' | asset_url | stylesheet_tag }}
{{ 'kahu-separator.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign s = section.settings

  case s.bg_color
    when 'custom'
      assign bg = s.bg_color_custom
    when 'transparent'
      assign bg = 'transparent'
    else
      assign bg = 'var(--kahu-' | append: s.bg_color | append: ')'
  endcase

  if s.text_color == 'custom'
    assign fg = s.text_color_custom
  else
    assign fg = 'var(--kahu-' | append: s.text_color | append: ')'
  endif

  if s.header_text_color == 'custom'
    assign head_fg = s.header_text_color_custom
  else
    assign head_fg = 'var(--kahu-' | append: s.header_text_color | default: 'navy' | append: ')'
  endif

  if s.columns_mobile == '1'
    assign slide_w = '82%'
  else
    assign slide_w = '46%'
  endif
-%}

{%- style -%}
  #kahu-cols-{{ section.id }} {
    --kc-bg: {{ bg }};
    --kc-fg: {{ fg }};
    --kc-cols-d: {{ s.columns_desktop }};
    --kc-cols-m: {{ s.columns_mobile }};
    --kc-slide-w: {{ slide_w }};
    --kc-ratio: {{ s.ratio }};
    --kc-radius: {{ s.radius }}px;
    --kc-gap: {{ s.gap_mobile }}px;
    --kc-pt: {{ s.mobile_padding_top }}px;
    --kc-pb: {{ s.mobile_padding_bottom }}px;
    --kc-mt: {{ s.mobile_margin_top }}px;
    --kc-mb: {{ s.mobile_margin_bottom }}px;
    --kc-btn-h: {{ s.btn_height_mobile | default: 44 }}px;
    --kc-btn-px: {{ s.btn_padding | default: 16 }}px;
    --kc-btn-fs: {{ s.btn_font | default: 12 }}px;
    --kc-btn-w: {{ s.btn_width_fixed | default: 176 }}px;
    --kc-head-fg: {{ head_fg }};
    --kc-head-gap: {{ s.header_gap_mobile | default: 24 }}px;
    --kc-in-pt: {{ s.in_pad_top_mobile | default: 20 }}px;
    --kc-in-px: {{ s.in_pad_side_mobile | default: 20 }}px;
    --kc-in-pb: {{ s.in_pad_bottom_mobile | default: 20 }}px;
  }
  @media (min-width: 750px) {
    #kahu-cols-{{ section.id }} {
      --kc-gap: {{ s.gap_desktop }}px;
      --kc-pt: {{ s.desktop_padding_top }}px;
      --kc-pb: {{ s.desktop_padding_bottom }}px;
      --kc-mt: {{ s.desktop_margin_top }}px;
      --kc-mb: {{ s.desktop_margin_bottom }}px;
      --kc-btn-h: {{ s.btn_height | default: 44 }}px;
      --kc-head-gap: {{ s.header_gap_desktop | default: 36 }}px;
      --kc-in-pt: {{ s.in_pad_top_desktop | default: 24 }}px;
      --kc-in-px: {{ s.in_pad_side_desktop | default: 24 }}px;
      --kc-in-pb: {{ s.in_pad_bottom_desktop | default: 24 }}px;
    }
  }
{%- endstyle -%}

<div
  id="kahu-cols-{{ section.id }}"
  class="kahu-cols kahu-cols--title-{{ s.title_size }} kahu-cols--btn-{{ s.btn_width | default: 'fixed' }}{% if s.mobile_layout == 'slider' %} kahu-cols--slider-m{% endif %}"
>
  {%- if s.bg_image -%}
    <div class="kahu-cols__bg" aria-hidden="true">
      {{ s.bg_image | image_url: width: 2880 | image_tag: widths: '750, 1100, 1440, 1920, 2880', sizes: '100vw', loading: 'lazy', alt: '' }}
    </div>
  {%- endif -%}

  {%- for block in section.blocks -%}
    {%- if block.type == 'separator' and block.settings.position == 'top' -%}
      {%- capture graphics -%}
        {%- if block.settings.g1_image -%}{%- render 'kahu-separator-graphic', g: block.settings, prefix: 'g1_' -%}{%- endif -%}
        {%- if block.settings.g2_image -%}{%- render 'kahu-separator-graphic', g: block.settings, prefix: 'g2_' -%}{%- endif -%}
      {%- endcapture -%}
      {%- render 'kahu-separator-body', s: block.settings, id: block.id, graphics: graphics, attrs: block.shopify_attributes -%}
    {%- endif -%}
  {%- endfor -%}

  <div class="kahu-cols__body">
  <div class="kahu-cols__inner{% unless s.full_width %} kahu-cols__inner--contained{% endunless %}">
    {%- capture header_row -%}
      {%- render 'kahu-header-row', blocks: section.blocks, layout: s.header_layout, right_align: s.header_right_align -%}
    {%- endcapture -%}
    {%- if header_row != blank -%}
      <div class="kahu-cols__head">{{ header_row }}</div>
    {%- endif -%}
    <div class="kahu-cols__grid">
      {%- for block in section.blocks -%}
        {%- if block.type != 'column' -%}{%- continue -%}{%- endif -%}
        {%- liquid
          assign b = block.settings
          assign has_inside = false
          if b.in_logo != blank or b.in_text != blank or b.in_title != blank and b.in_title_position != 'below_image'
            assign has_inside = true
          endif
          assign btn_inside = false
          if b.button_label != blank and b.button_position == 'inside'
            assign btn_inside = true
          endif
          assign has_media = false
          if b.image != blank or b.sticker != blank or has_inside or btn_inside
            assign has_media = true
          endif

          assign ratio = b.ratio
          if ratio == 'inherit'
            assign ratio = s.ratio
          endif

          case b.in_color
            when 'navy'
              assign in_fg = 'var(--kahu-navy)'
            when 'white'
              assign in_fg = 'var(--kahu-white)'
            else
              assign in_fg = 'var(--kahu-cream)'
          endcase

          assign card_label = b.title | default: b.in_title | default: b.button_label

          assign has_below = false
          if b.title != blank or b.text != blank
            assign has_below = true
          endif
          if b.button_label != blank and btn_inside == false
            assign has_below = true
          endif

          assign sticker_class = 'kahu-col__sticker kahu-col__sticker--' | append: b.sticker_position
          assign sticker_style = '--kc-sticker-w: ' | append: b.sticker_width | append: '%; --kc-sticker-rot: ' | append: b.sticker_rotate | append: 'deg;'
          assign logo_style = '--kc-logo-w: ' | append: b.in_logo_width | append: 'px;'

          assign title_pos = b.in_title_position | default: 'beside'
          assign title_inside = false
          if b.in_title != blank and title_pos != 'below_image'
            assign title_inside = true
          endif
          assign title_below_image = false
          if b.in_title != blank and title_pos == 'below_image'
            assign title_below_image = true
            assign has_below = true
          endif
          assign divider = b.in_divider | default: 'none'
          assign brand_style = '--kc-div-h: ' | append: b.in_divider_height | append: 'px; --kc-div-w: ' | append: b.in_divider_thickness | append: 'px; --kc-div-gap: ' | append: b.in_divider_gap | append: 'px; --kc-in-title-d: ' | append: b.in_title_size | append: 'px;'
        -%}

        <div
          class="kahu-col"
          style="--kc-card-ratio: {{ ratio }}; --kc-overlay: {{ b.overlay | divided_by: 100.0 }}; --kc-in-fg: {{ in_fg }};"
          {{ block.shopify_attributes }}
        >
          {%- if has_media -%}
            <div class="kahu-col__media{% if ratio == 'natural' %} kahu-col__media--natural{% endif %}">
              <div class="kahu-col__frame">
                {%- if b.image -%}
                  <picture>
                    {%- if b.image_mobile -%}
                      <source
                        media="(max-width: 749px)"
                        srcset="{{ b.image_mobile | image_url: width: 600 }} 600w, {{ b.image_mobile | image_url: width: 900 }} 900w, {{ b.image_mobile | image_url: width: 1200 }} 1200w"
                        sizes="85vw">
                    {%- endif -%}
                    {{ b.image | image_url: width: 1400 | image_tag:
                        widths: '300, 450, 600, 900, 1200, 1400',
                        sizes: '(min-width: 750px) calc(100vw / 3), 85vw',
                        loading: 'lazy',
                        class: 'kahu-col__img',
                        alt: b.alt | default: b.image.alt }}
                  </picture>
                {%- else -%}
                  {{ 'image' | placeholder_svg_tag: 'kahu-col__img kahu-col__img--placeholder' }}
                {%- endif -%}

                {%- if b.overlay > 0 -%}
                  <span class="kahu-col__overlay kahu-col__overlay--{{ b.overlay_style }}" aria-hidden="true"></span>
                {%- endif -%}
              </div>

              {%- if b.link != blank -%}
                <a class="kahu-col__cover-link" href="{{ b.link }}"{% if card_label != blank %} aria-label="{{ card_label | escape }}"{% endif %}></a>
              {%- endif -%}

              {%- if b.sticker -%}
                {{ b.sticker | image_url: width: 800 | image_tag:
                    widths: '200, 400, 600, 800',
                    sizes: '320px',
                    loading: 'lazy',
                    class: sticker_class,
                    style: sticker_style,
                    alt: '' }}
              {%- endif -%}

              {%- if has_inside or btn_inside -%}
                <div class="kahu-col__inside kahu-col__inside--{{ b.in_position }}">
                  {%- if b.in_logo or title_inside -%}
                    <div class="kahu-col__brand kahu-col__brand--{{ title_pos }}" style="{{ brand_style }}">
                      {%- if b.in_logo -%}
                        {{ b.in_logo | image_url: width: 200 | image_tag:
                            class: 'kahu-col__logo',
                            style: logo_style,
                            loading: 'lazy',
                            alt: '' }}
                      {%- endif -%}
                      {%- if b.in_logo and title_inside and title_pos == 'beside' and divider != 'none' -%}
                        {%- if divider == 'curved' -%}
                          <svg class="kahu-col__divider kahu-col__divider--curved" viewBox="0 0 12 100" preserveAspectRatio="none" aria-hidden="true" focusable="false">
                            <path d="M3 0 Q 11 50 3 100" fill="none" stroke="currentColor" stroke-width="{{ b.in_divider_thickness }}" vector-effect="non-scaling-stroke" stroke-linecap="round"/>
                          </svg>
                        {%- else -%}
                          <span class="kahu-col__divider kahu-col__divider--{{ divider }}" aria-hidden="true"></span>
                        {%- endif -%}
                      {%- endif -%}
                      {%- if title_inside -%}
                        <h3 class="kahu-col__in-title">{{ b.in_title | escape | replace: '|', '<br>' }}</h3>
                      {%- endif -%}
                    </div>
                  {%- endif -%}
                  {%- if b.in_text != blank -%}
                    <div class="kahu-col__in-text">{{ b.in_text }}</div>
                  {%- endif -%}
                  {%- if btn_inside -%}
                    <div class="kahu-col__btn kahu-col__btn--inside{% if b.button_full %} kahu-col__btn--full{% endif %}">
                      <a class="kahu-btn kahu-btn--{{ b.button_style }}" href="{{ b.button_link | default: b.link | default: routes.all_products_collection_url }}">
                        <span class="kahu-btn__label">{{ b.button_label | escape }}</span>
                        <span class="kahu-btn__arrow" aria-hidden="true">→</span>
                      </a>
                    </div>
                  {%- endif -%}
                </div>
              {%- endif -%}
            </div>
          {%- endif -%}

          {%- if has_below -%}
            <div class="kahu-col__below">
              {%- if title_below_image -%}
                <h3 class="kahu-col__title kahu-col__title--moved" style="{{ brand_style }}">{{ b.in_title | escape | replace: '|', '<br>' }}</h3>
              {%- endif -%}
              {%- if b.title != blank -%}
                <h3 class="kahu-col__title">
                  {%- if b.link != blank -%}<a href="{{ b.link }}" tabindex="-1">{{ b.title | escape }}</a>{%- else -%}{{ b.title | escape }}{%- endif -%}
                </h3>
              {%- endif -%}
              {%- if b.text != blank -%}
                <div class="kahu-col__text">{{ b.text }}</div>
              {%- endif -%}
              {%- if b.button_label != blank and btn_inside == false -%}
                <div class="kahu-col__btn{% if b.button_full %} kahu-col__btn--full{% endif %}">
                  <a class="kahu-btn kahu-btn--{{ b.button_style }}" href="{{ b.button_link | default: b.link | default: routes.all_products_collection_url }}">
                    <span class="kahu-btn__label">{{ b.button_label | escape }}</span>
                    <span class="kahu-btn__arrow" aria-hidden="true">→</span>
                  </a>
                </div>
              {%- endif -%}
            </div>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
  </div>

  {%- for block in section.blocks -%}
    {%- if block.type == 'separator' and block.settings.position == 'bottom' -%}
      {%- capture graphics -%}
        {%- if block.settings.g1_image -%}{%- render 'kahu-separator-graphic', g: block.settings, prefix: 'g1_' -%}{%- endif -%}
        {%- if block.settings.g2_image -%}{%- render 'kahu-separator-graphic', g: block.settings, prefix: 'g2_' -%}{%- endif -%}
      {%- endcapture -%}
      {%- render 'kahu-separator-body', s: block.settings, id: block.id, graphics: graphics, attrs: block.shopify_attributes -%}
    {%- endif -%}
  {%- endfor -%}
</div>

{% schema %}
{"name":"Kahu columns","tag":"section","class":"kahu-columns-section","max_blocks":30,"settings":[{"type":"header","content":"Columns"},{"type":"range","id":"columns_desktop","label":"Columns (desktop)","min":1,"max":6,"step":1,"default":4},{"type":"select","id":"columns_mobile","label":"Columns (mobile)","options":[{"value":"1","label":"1"},{"value":"2","label":"2"}],"default":"1"},{"type":"select","id":"mobile_layout","label":"Mobile layout","options":[{"value":"slider","label":"Swipe row"},{"value":"grid","label":"Stacked grid"}],"default":"slider"},{"type":"range","id":"gap_desktop","label":"Gap (desktop)","min":0,"max":60,"step":2,"unit":"px","default":8},{"type":"range","id":"gap_mobile","label":"Gap (mobile)","min":0,"max":40,"step":2,"unit":"px","default":8},{"type":"checkbox","id":"full_width","label":"Full width (no max width)","default":false},{"type":"header","content":"Cards"},{"type":"select","id":"ratio","label":"Image shape","options":[{"value":"314 / 492","label":"Tall (Benefits, 314 × 492)"},{"value":"413 / 628","label":"Tall (Size cards, 413 × 628)"},{"value":"314 / 390","label":"Portrait (Occasions, 314 × 390)"},{"value":"4 / 5","label":"Portrait 4:5"},{"value":"1 / 1","label":"Square"},{"value":"16 / 9","label":"Landscape 16:9"},{"value":"natural","label":"Image's own shape"}],"default":"314 / 492","info":"Each column can override this"},{"type":"range","id":"radius","label":"Corner radius","min":0,"max":24,"step":1,"unit":"px","default":0},{"type":"select","id":"title_size","label":"Title size (below image)","options":[{"value":"sm","label":"Small (20px)"},{"value":"md","label":"Medium (32px)"},{"value":"lg","label":"Large (40px)"}],"default":"sm"},{"type":"header","content":"Header (eyebrow / title / button blocks)"},{"type":"select","id":"header_layout","label":"Header layout","options":[{"value":"split","label":"Left text, right button/image"},{"value":"center","label":"Centred (everything stacked)"}],"default":"split"},{"type":"select","id":"header_right_align","label":"Header right column alignment","options":[{"value":"end","label":"Bottom"},{"value":"center","label":"Middle"},{"value":"start","label":"Top"}],"default":"end"},{"type":"select","id":"header_text_color","label":"Header text colour","options":[{"value":"navy","label":"Navy"},{"value":"cream","label":"Cream"},{"value":"ink","label":"Ink"},{"value":"white","label":"White"},{"value":"custom","label":"Custom"}],"default":"navy"},{"type":"color","id":"header_text_color_custom","label":"Custom header text colour","default":"#031426","visible_if":"{{ section.settings.header_text_color == 'custom' }}"},{"type":"range","id":"header_gap_desktop","label":"Space below header (desktop)","min":0,"max":160,"step":2,"unit":"px","default":36},{"type":"range","id":"header_gap_mobile","label":"Space below header (mobile)","min":0,"max":120,"step":2,"unit":"px","default":24},{"type":"header","content":"Card buttons"},{"type":"select","id":"btn_width","label":"Button width","options":[{"value":"fixed","label":"Fixed"},{"value":"auto","label":"Fit the text"},{"value":"full","label":"Full card width"}],"default":"fixed"},{"type":"range","id":"btn_width_fixed","label":"Fixed width","min":120,"max":320,"step":4,"unit":"px","default":176,"visible_if":"{{ section.settings.btn_width == 'fixed' }}"},{"type":"range","id":"btn_height","label":"Height (desktop)","min":32,"max":64,"step":2,"unit":"px","default":44},{"type":"range","id":"btn_height_mobile","label":"Height (mobile)","min":28,"max":56,"step":2,"unit":"px","default":40},{"type":"range","id":"btn_padding","label":"Side padding","min":8,"max":40,"step":2,"unit":"px","default":16},{"type":"range","id":"btn_font","label":"Text size","min":10,"max":18,"step":1,"unit":"px","default":12},{"type":"header","content":"Spacing inside the image","info":"Space between the card edges and the logo, text and button inside the image. Bottom = space under the button"},{"type":"range","id":"in_pad_top_desktop","label":"Top (