{%- comment -%}
  Kahu columns: reusable multi-column cards, every column is a block.
  Figma uses: Benefits 723:75 (image + sticker + title below), Size cards 723:104 (logo + name + fit text + button
  inside the image), Occasions 723:167 (image + rotated sticker + title below), Kahu TV, etc.
  Spec: handoff/004-section-header-and-columns.md
  Each Column block can use any mix of:
    - Image (desktop + mobile), own shape, overlay gradient, whole-card link
    - Sticker graphic on top (position, size, rotation)
    - Inside-image content: logo, title, text (position + colour)
    - Below-image content: title, text
    - Button: inside the image or below it
  Blank fields are simply not shown, so a column can be image-only.
  Pair with "Kahu section header" above it for the eyebrow / title / button row.
{%- endcomment -%}

{%- liquid
  assign s = section.settings

  case s.bg_color
    when 'custom'
      assign bg = s.bg_color_custom
    when 'transparent'
      assign bg = 'transparent'
    else
      assign bg = 'var(--kahu-' | append: s.bg_color | append: ')'
  endcase

  if s.text_color == 'custom'
    assign fg = s.text_color_custom
  else
    assign fg = 'var(--kahu-' | append: s.text_color | append: ')'
  endif

  if s.columns_mobile == '1'
    assign slide_w = '82%'
  else
    assign slide_w = '46%'
  endif
-%}

{%- style -%}
  #kahu-cols-{{ section.id }} {
    --kc-bg: {{ bg }};
    --kc-fg: {{ fg }};
    --kc-cols-d: {{ s.columns_desktop }};
    --kc-cols-m: {{ s.columns_mobile }};
    --kc-slide-w: {{ slide_w }};
    --kc-ratio: {{ s.ratio }};
    --kc-radius: {{ s.radius }}px;
    --kc-gap: {{ s.gap_mobile }}px;
    --kc-pt: {{ s.mobile_padding_top }}px;
    --kc-pb: {{ s.mobile_padding_bottom }}px;
    --kc-mt: {{ s.mobile_margin_top }}px;
    --kc-mb: {{ s.mobile_margin_bottom }}px;
  }
  @media (min-width: 750px) {
    #kahu-cols-{{ section.id }} {
      --kc-gap: {{ s.gap_desktop }}px;
      --kc-pt: {{ s.desktop_padding_top }}px;
      --kc-pb: {{ s.desktop_padding_bottom }}px;
      --kc-mt: {{ s.desktop_margin_top }}px;
      --kc-mb: {{ s.desktop_margin_bottom }}px;
    }
  }
{%- endstyle -%}

<div
  id="kahu-cols-{{ section.id }}"
  class="kahu-cols kahu-cols--title-{{ s.title_size }}{% if s.mobile_layout == 'slider' %} kahu-cols--slider-m{% endif %}"
>
  {%- if s.bg_image -%}
    <div class="kahu-cols__bg" aria-hidden="true">
      {{ s.bg_image | image_url: width: 2880 | image_tag: widths: '750, 1100, 1440, 1920, 2880', sizes: '100vw', loading: 'lazy', alt: '' }}
    </div>
  {%- endif -%}

  <div class="kahu-cols__inner{% unless s.full_width %} kahu-cols__inner--contained{% endunless %}">
    <div class="kahu-cols__grid">
      {%- for block in section.blocks -%}
        {%- liquid
          assign b = block.settings
          assign has_inside = false
          if b.in_logo != blank or b.in_title != blank or b.in_text != blank
            assign has_inside = true
          endif
          assign btn_inside = false
          if b.button_label != blank and b.button_position == 'inside'
            assign btn_inside = true
          endif
          assign has_media = false
          if b.image != blank or b.sticker != blank or has_inside or btn_inside
            assign has_media = true
          endif

          assign ratio = b.ratio
          if ratio == 'inherit'
            assign ratio = s.ratio
          endif

          case b.in_color
            when 'navy'
              assign in_fg = 'var(--kahu-navy)'
            when 'white'
              assign in_fg = 'var(--kahu-white)'
            else
              assign in_fg = 'var(--kahu-cream)'
          endcase

          assign card_label = b.title | default: b.in_title | default: b.button_label

          assign has_below = false
          if b.title != blank or b.text != blank
            assign has_below = true
          endif
          if b.button_label != blank and btn_inside == false
            assign has_below = true
          endif

          assign sticker_class = 'kahu-col__sticker kahu-col__sticker--' | append: b.sticker_position
          assign sticker_style = '--kc-sticker-w: ' | append: b.sticker_width | append: '%; --kc-sticker-rot: ' | append: b.sticker_rotate | append: 'deg;'
          assign logo_style = '--kc-logo-w: ' | append: b.in_logo_width | append: 'px;'
        -%}

        <div
          class="kahu-col"
          style="--kc-card-ratio: {{ ratio }}; --kc-overlay: {{ b.overlay | divided_by: 100.0 }}; --kc-in-fg: {{ in_fg }};"
          {{ block.shopify_attributes }}
        >
          {%- if has_media -%}
            <div class="kahu-col__media{% if ratio == 'natural' %} kahu-col__media--natural{% endif %}">
              <div class="kahu-col__frame">
                {%- if b.image -%}
                  <picture>
                    {%- if b.image_mobile -%}
                      <source
                        media="(max-width: 749px)"
                        srcset="{{ b.image_mobile | image_url: width: 600 }} 600w, {{ b.image_mobile | image_url: width: 900 }} 900w, {{ b.image_mobile | image_url: width: 1200 }} 1200w"
                        sizes="85vw">
                    {%- endif -%}
                    {{ b.image | image_url: width: 1400 | image_tag:
                        widths: '300, 450, 600, 900, 1200, 1400',
                        sizes: '(min-width: 750px) calc(100vw / 3), 85vw',
                        loading: 'lazy',
                        class: 'kahu-col__img',
                        alt: b.alt | default: b.image.alt }}
                  </picture>
                {%- else -%}
                  {{ 'image' | placeholder_svg_tag: 'kahu-col__img kahu-col__img--placeholder' }}
                {%- endif -%}

                {%- if b.overlay > 0 -%}
                  <span class="kahu-col__overlay kahu-col__overlay--{{ b.overlay_style }}" aria-hidden="true"></span>
                {%- endif -%}
              </div>

              {%- if b.link != blank -%}
                <a class="kahu-col__cover-link" href="{{ b.link }}"{% if card_label != blank %} aria-label="{{ card_label | escape }}"{% endif %}></a>
              {%- endif -%}

              {%- if b.sticker -%}
                {{ b.sticker | image_url: width: 800 | image_tag:
                    widths: '200, 400, 600, 800',
                    sizes: '320px',
                    loading: 'lazy',
                    class: sticker_class,
                    style: sticker_style,
                    alt: '' }}
              {%- endif -%}

              {%- if has_inside or btn_inside -%}
                <div class="kahu-col__inside kahu-col__inside--{{ b.in_position }}">
                  {%- if b.in_logo -%}
                    {{ b.in_logo | image_url: width: 200 | image_tag:
                        class: 'kahu-col__logo',
                        style: logo_style,
                        loading: 'lazy',
                        alt: '' }}
                  {%- endif -%}
                  {%- if b.in_title != blank -%}
                    <h3 class="kahu-col__in-title">{{ b.in_title | escape | replace: '|', '<br>' }}</h3>
                  {%- endif -%}
                  {%- if b.in_text != blank -%}
                    <div class="kahu-col__in-text">{{ b.in_text }}</div>
                  {%- endif -%}
                  {%- if btn_inside -%}
                    <div class="kahu-col__btn kahu-col__btn--inside{% if b.button_full %} kahu-col__btn--full{% endif %}">
                      <a class="kahu-btn kahu-btn--{{ b.button_style }}" href="{{ b.button_link | default: b.link | default: routes.all_products_collection_url }}">
                        <span class="kahu-btn__label">{{ b.button_label | escape }}</span>
                        <span class="kahu-btn__arrow" aria-hidden="true">→</span>
                      </a>
                    </div>
                  {%- endif -%}
                </div>
              {%- endif -%}
            </div>
          {%- endif -%}

          {%- if has_below -%}
            <div class="kahu-col__below">
              {%- if b.title != blank -%}
                <h3 class="kahu-col__title">
                  {%- if b.link != blank -%}<a href="{{ b.link }}" tabindex="-1">{{ b.title | escape }}</a>{%- else -%}{{ b.title | escape }}{%- endif -%}
                </h3>
              {%- endif -%}
              {%- if b.text != blank -%}
                <div class="kahu-col__text">{{ b.text }}</div>
              {%- endif -%}
              {%- if b.button_label != blank and btn_inside == false -%}
                <div class="kahu-col__btn{% if b.button_full %} kahu-col__btn--full{% endif %}">
                  <a class="kahu-btn kahu-btn--{{ b.button_style }}" href="{{ b.button_link | default: b.link | default: routes.all_products_collection_url }}">
                    <span class="kahu-btn__label">{{ b.button_label | escape }}</span>
                    <span class="kahu-btn__arrow" aria-hidden="true">→</span>
                  </a>
                </div>
              {%- endif -%}
            </div>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .kahu-cols {
    position: relative;
    isolation: isolate;
    background: var(--kc-bg);
    color: var(--kc-fg);
    padding-top: var(--kc-pt);
    padding-bottom: var(--kc-pb);
    margin-top: var(--kc-mt);
    margin-bottom: var(--kc-mb);
    font-family: var(--kahu-font-sans);
  }
  .kahu-cols__bg { position: absolute; inset: 0; z-index: -1; }
  .kahu-cols__bg img { width: 100%; height: 100%; object-fit: cover; display: block; }

  .kahu-cols__inner { padding: 0 var(--kahu-gutter, 20px); }
  .kahu-cols__inner--contained { max-width: calc(var(--kahu-content, 1280px) + var(--kahu-gutter, 20px) * 2); margin: 0 auto; }

  .kahu-cols__grid {
    display: grid;
    grid-template-columns: repeat(var(--kc-cols-m), minmax(0, 1fr));
    gap: var(--kc-gap);
  }

  /* Mobile swipe row */
  @media (max-width: 749px) {
    .kahu-cols--slider-m .kahu-cols__inner { padding-right: 0; }
    .kahu-cols--slider-m .kahu-cols__grid {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
      padding-right: var(--kahu-gutter, 20px);
      -webkit-overflow-scrolling: touch;
    }
    .kahu-cols--slider-m .kahu-cols__grid::-webkit-scrollbar { display: none; }
    .kahu-cols--slider-m .kahu-col { flex: 0 0 var(--kc-slide-w); scroll-snap-align: start; }
  }

  .kahu-col { position: relative; display: flex; flex-direction: column; min-width: 0; }

  .kahu-col__media { position: relative; }
  .kahu-col__frame {
    position: relative;
    aspect-ratio: var(--kc-card-ratio, 314 / 492);
    overflow: hidden;
    border-radius: var(--kc-radius);
  }
  .kahu-col__media--natural .kahu-col__frame { aspect-ratio: auto; }
  .kahu-col__img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .kahu-col__media--natural .kahu-col__img { height: auto; }
  .kahu-col__img--placeholder { background: rgb(0 0 0 / 0.06); }

  .kahu-col__overlay { position: absolute; inset: 0; pointer-events: none; }
  .kahu-col__overlay--bottom { background: linear-gradient(0deg, rgb(0 0 0 / var(--kc-overlay)) 0%, rgb(0 0 0 / 0) 60%); }
  .kahu-col__overlay--top { background: linear-gradient(180deg, rgb(0 0 0 / var(--kc-overlay)) 0%, rgb(0 0 0 / 0) 60%); }
  .kahu-col__overlay--diagonal { background: linear-gradient(160deg, rgb(0 0 0 / var(--kc-overlay)) 0%, rgb(0 0 0 / 0) 55%); }
  .kahu-col__overlay--flat { background: rgb(0 0 0 / var(--kc-overlay)); }

  .kahu-col__cover-link { position: absolute; inset: 0; z-index: 1; }
  .kahu-col__cover-link:focus-visible { outline: 2px solid var(--kahu-yellow); outline-offset: 2px; }

  .kahu-col__sticker {
    position: absolute;
    z-index: 2;
    width: var(--kc-sticker-w, 60%);
    height: auto;
    rotate: var(--kc-sticker-rot, 0deg);
    pointer-events: none;
  }
  .kahu-col__sticker--top-left { top: 6%; left: 6%; }
  .kahu-col__sticker--top-right { top: 6%; right: 6%; }
  .kahu-col__sticker--top-center { top: 6%; left: 50%; translate: -50% 0; }
  .kahu-col__sticker--center { top: 50%; left: 50%; translate: -50% -50%; }
  .kahu-col__sticker--bottom-left { bottom: 6%; left: 6%; }
  .kahu-col__sticker--bottom-right { bottom: 6%; right: 6%; }
  .kahu-col__sticker--bottom-center { bottom: 6%; left: 50%; translate: -50% 0; }

  .kahu-col__inside {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 20px;
    color: var(--kc-in-fg);
    pointer-events: none;
  }
  .kahu-col__inside a { pointer-events: auto; }
  .kahu-col__inside--top-left { justify-content: flex-start; align-items: flex-start; }
  .kahu-col__inside--top-right { justify-content: flex-start; align-items: flex-end; text-align: right; }
  .kahu-col__inside--bottom-left { justify-content: flex-end; align-items: flex-start; }
  .kahu-col__inside--bottom-right { justify-content: flex-end; align-items: flex-end; text-align: right; }
  .kahu-col__inside--center { justify-content: center; align-items: center; text-align: center; }
  .kahu-col__inside--split { justify-content: space-between; align-items: flex-start; }

  .kahu-col__logo { width: var(--kc-logo-w, 40px); height: auto; display: block; }
  .kahu-col__in-title { margin: 0; font-weight: 700; font-size: 32px; line-height: 1; color: inherit; }
  .kahu-col__in-text { font-size: 14px; line-height: 1.2; }
  .kahu-col__in-text p { margin: 0; }
  .kahu-col__in-text strong { font-size: 16px; font-weight: 700; }
  .kahu-col__in-text p + p { margin-top: 4px; }
  .kahu-col__btn--inside { margin-top: auto; }
  .kahu-col__inside--split .kahu-col__btn--inside { margin-top: auto; }

  .kahu-col__below { padding-top: 10px; display: flex; flex-direction: column; gap: 8px; }
  .kahu-col__title { margin: 0; font-weight: 700; line-height: 1; color: inherit; }
  .kahu-col__title a { color: inherit; text-decoration: none; }
  .kahu-cols--title-sm .kahu-col__title { font-size: 18px; }
  .kahu-cols--title-md .kahu-col__title { font-size: 24px; }
  .kahu-cols--title-lg .kahu-col__title { font-size: 28px; }
  .kahu-col__text { font-size: 15px; line-height: 1.3; }
  .kahu-col__text p { margin: 0; }
  .kahu-col__btn { margin-top: 6px; }
  .kahu-col__btn--full .kahu-btn { width: 100%; min-width: 0; }

  @media (min-width: 750px) {
    .kahu-cols__grid { grid-template-columns: repeat(var(--kc-cols-d), minmax(0, 1fr)); }
    .kahu-col__inside { padding: 24px; }
    .kahu-col__in-title { font-size: 40px; }
    .kahu-cols--title-sm .kahu-col__title { font-size: 20px; }
    .kahu-cols--title-md .kahu-col__title { font-size: 32px; }
    .kahu-cols--title-lg .kahu-col__title { font-size: 40px; }
    .kahu-col__text { font-size: 16px; }
  }

  @media (hover: hover) {
    .kahu-col__img { transition: scale 0.5s ease; }
    .kahu-col:has(.kahu-col__cover-link:hover) .kahu-col__img { scale: 1.03; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Kahu columns",
  "tag": "section",
  "class": "kahu-columns-section",
  "max_blocks": 12,
  "settings": [
    { "type": "header", "content": "Columns" },
    { "type": "range", "id": "columns_desktop", "label": "Columns (desktop)", "min": 1, "max": 6, "step": 1, "default": 4 },
    { "type": "select", "id": "columns_mobile", "label": "Columns (mobile)", "options": [ { "value": "1", "label": "1" }, { "value": "2", "label": "2" } ], "default": "1" },
    {
      "type": "select", "id": "mobile_layout", "label": "Mobile layout",
      "options": [ { "value": "slider", "label": "Swipe row" }, { "value": "grid", "label": "Stacked grid" } ],
      "default": "slider"
    },
    { "type": "range", "id": "gap_desktop", "label": "Gap (desktop)", "min": 0, "max": 60, "step": 2, "unit": "px", "default": 8 },
    { "type": "range", "id": "gap_mobile", "label": "Gap (mobile)", "min": 0, "max": 40, "step": 2, "unit": "px", "default": 8 },
    { "type": "checkbox", "id": "full_width", "label": "Full width (no max width)", "default": false },

    { "type": "header", "content": "Cards" },
    {
      "type": "select", "id": "ratio", "label": "Image shape",
      "options": [
        { "value": "314 / 492", "label": "Tall (Benefits, 314 × 492)" },
        { "value": "413 / 628", "label": "Tall (Size cards, 413 × 628)" },
        { "value": "314 / 390", "label": "Portrait (Occasions, 314 × 390)" },
        { "value": "4 / 5", "label": "Portrait 4:5" },
        { "value": "1 / 1", "label": "Square" },
        { "value": "16 / 9", "label": "Landscape 16:9" },
        { "value": "natural", "label": "Image's own shape" }
      ],
      "default": "314 / 492",
      "info": "Each column can override this"
    },
    { "type": "range", "id": "radius", "label": "Corner radius", "min": 0, "max": 24, "step": 1, "unit": "px", "default": 0 },
    {
      "type": "select", "id": "title_size", "label": "Title size (below image)",
      "options": [ { "value": "sm", "label": "Small (20px)" }, { "value": "md", "label": "Medium (32px)" }, { "value": "lg", "label": "Large (40px)" } ],
      "default": "sm"
    },

    { "type": "header", "content": "Colours" },
    {
      "type": "select", "id": "bg_color", "label": "Background",
      "options": [
        { "value": "cream", "label": "Cream" }, { "value": "navy", "label": "Navy" }, { "value": "ink", "label": "Ink" },
        { "value": "teal", "label": "Teal" }, { "value": "yellow", "label": "Yellow" }, { "value": "sea", "label": "Sea" },
        { "value": "white", "label": "White" }, { "value": "coral", "label": "Coral" },
        { "value": "transparent", "label": "Transparent" }, { "value": "custom", "label": "Custom" }
      ],
      "default": "cream"
    },
    { "type": "color", "id": "bg_color_custom", "label": "Custom background", "default": "#f3efe5", "visible_if": "{{ section.settings.bg_color == 'custom' }}" },
    { "type": "image_picker", "id": "bg_image", "label": "Background image" },
    {
      "type": "select", "id": "text_color", "label": "Text (below images)",
      "options": [
        { "value": "navy", "label": "Navy" }, { "value": "cream", "label": "Cream" }, { "value": "ink", "label": "Ink" },
        { "value": "white", "label": "White" }, { "value": "custom", "label": "Custom" }
      ],
      "default": "navy"
    },
    { "type": "color", "id": "text_color_custom", "label": "Custom text colour", "default": "#031426", "visible_if": "{{ section.settings.text_color == 'custom' }}" },

    { "type": "header", "content": "Desktop spacing" },
    { "type": "range", "id": "desktop_padding_top", "label": "Padding top", "min": 0, "max": 200, "step": 2, "unit": "px", "default": 0 },
    { "type": "range", "id": "desktop_padding_bottom", "label": "Padding bottom", "min": 0, "max": 200, "step": 2, "unit": "px", "default": 46 },
    { "type": "range", "id": "desktop_margin_top", "label": "Margin top", "min": 0, "max": 200, "step": 2, "unit": "px", "default": 0 },
    { "type": "range", "id": "desktop_margin_bottom", "label": "Margin bottom", "min": 0, "max": 200, "step": 2, "unit": "px", "default": 0 },

    { "type": "header", "content": "Mobile spacing" },
    { "type": "range", "id": "mobile_padding_top", "label": "Padding top", "min": 0, "max": 160, "step": 2, "unit": "px", "default": 0 },
    { "type": "range", "id": "mobile_padding_bottom", "label": "Padding bottom", "min": 0, "max": 160, "step": 2, "unit": "px", "default": 32 },
    { "type": "range", "id": "mobile_margin_top", "label": "Margin top", "min": 0, "max": 160, "step": 2, "unit": "px", "default": 0 },
    { "type": "range", "id": "mobile_margin_bottom", "label": "Margin bottom", "min": 0, "max": 160, "step": 2, "unit": "px", "default": 0 }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Column",
      "settings": [
        { "type": "header", "content": "Image" },
        { "type": "image_picker", "id": "image", "label": "Image", "info": "WebP" },
        { "type": "image_picker", "id": "image_mobile", "label": "Image (mobile, optional)" },
        { "type": "text", "id": "alt", "label": "Alt text" },
        {
          "type": "select", "id": "ratio", "label": "Image shape",
          "options": [
            { "value": "inherit", "label": "Same as section" },
            { "value": "314 / 492", "label": "Tall (Benefits)" },
            { "value": "413 / 628", "label": "Tall (Size cards)" },
            { "value": "314 / 390", "label": "Portrait (Occasions)" },
            { "value": "4 / 5", "label": "Portrait 4:5" },
            { "value": "1 / 1", "label": "Square" },
            { "value": "16 / 9", "label": "Landscape 16:9" },
            { "value": "natural", "label": "Image's own shape" }
          ],
          "default": "inherit"
        },
        { "type": "url", "id": "link", "label": "Card link", "info": "Makes the whole image clickable" },
        { "type": "range", "id": "overlay", "label": "Dark overlay", "min": 0, "max": 90, "step": 5, "unit": "%", "default": 0 },
        {
          "type": "select", "id": "overlay_style", "label": "Overlay style",
          "options": [
            { "value": "bottom", "label": "Gradient from bottom" },
            { "value": "top", "label": "Gradient from top" },
            { "value": "diagonal", "label": "Diagonal from top-left" },
            { "value": "flat", "label": "Flat" }
          ],
          "default": "bottom"
        },

        { "type": "header", "content": "Sticker" },
        { "type": "image_picker", "id": "sticker", "label": "Sticker graphic", "info": "Transparent WebP/PNG" },
        { "type": "range", "id": "sticker_width", "label": "Sticker width", "min": 10, "max": 100, "step": 5, "unit": "%", "default": 60 },
        {
          "type": "select", "id": "sticker_position", "label": "Sticker position",
          "options": [
            { "value": "top-left", "label": "Top left" }, { "value": "top-center", "label": "Top centre" }, { "value": "top-right", "label": "Top right" },
            { "value": "center", "label": "Centre" },
            { "value": "bottom-left", "label": "Bottom left" }, { "value": "bottom-center", "label": "Bottom centre" }, { "value": "bottom-right", "label": "Bottom right" }
          ],
          "default": "bottom-left"
        },
        { "type": "range", "id": "sticker_rotate", "label": "Sticker rotation", "min": -20, "max": 20, "step": 1, "unit": "deg", "default": 0 },

