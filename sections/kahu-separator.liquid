{%- comment -%}
  Kahu separator: a stand-alone curved divider (or plain space) placed BETWEEN two sections.
  Spec: handoff/002-separator.md · Curve drawing: snippets/kahu-wave.liquid (same shapes as the hero)
  Stacking rule (_project/stacking-rules.md):
    - Curve colour      = background of the section the curve flows INTO
    - Background colour = background of the section on the other side
  Modes:
    - "overlap": pulls up over the bottom of the section above (e.g. over a photo), transparent behind
    - "stack":   takes its own space, painted with the background colour
  Extra space: solid bands above/below the curve (e.g. extend the colour under the wave).
  Graphic blocks: decorative images placed anywhere on the separator (Figma: sea turtle + manta ray on the
  bottle → Kahu TV wave, octopus + coral further down). They may overhang into the neighbouring sections.
{%- endcomment -%}

{%- liquid
  assign s = section.settings

  if s.bg_color == 'custom'
    assign bg = s.bg_color_custom
  elsif s.bg_color == 'transparent'
    assign bg = 'transparent'
  else
    assign bg = 'var(--kahu-' | append: s.bg_color | append: ')'
  endif

  if s.wave_color == 'custom'
    assign fill = s.wave_color_custom
  else
    assign fill = 'var(--kahu-' | append: s.wave_color | append: ')'
  endif

  if s.mode == 'overlap'
    assign bg = 'transparent'
  endif

  # Which colour sits on each side of the curve
  if s.direction == 'down'
    assign wave_position = 'top'
    assign top_color = fill
    assign bottom_color = bg
  else
    assign wave_position = 'bottom'
    assign top_color = bg
    assign bottom_color = fill
  endif

  assign extra_top_d = s.extra_top_desktop | default: 0
  assign extra_top_m = s.extra_top_mobile | default: 0
  assign extra_bottom_d = s.extra_bottom_desktop | default: 0
  assign extra_bottom_m = s.extra_bottom_mobile | default: 0
-%}

{%- style -%}
  #kahu-sep-{{ section.id }} {
    --kahu-sep-h: {{ s.height_mobile }}px;
    --kahu-sep-top: {{ extra_top_m }}px;
    --kahu-sep-bottom: {{ extra_bottom_m }}px;
    --kahu-sep-bg: {{ bg }};
    --kahu-sep-fill: {{ fill }};
    --kahu-sep-top-color: {{ top_color }};
    --kahu-sep-bottom-color: {{ bottom_color }};
  }
  @media (min-width: 750px) {
    #kahu-sep-{{ section.id }} {
      --kahu-sep-h: {{ s.height_desktop }}px;
      --kahu-sep-top: {{ extra_top_d }}px;
      --kahu-sep-bottom: {{ extra_bottom_d }}px;
    }
  }
{%- endstyle -%}

<div
  id="kahu-sep-{{ section.id }}"
  class="kahu-sep kahu-sep--{{ s.mode }}{% if s.shape == 'flat' %} kahu-sep--flat{% endif %}"
  role="presentation"
>
  <div class="kahu-sep__band kahu-sep__band--top"></div>

  <div class="kahu-sep__curve" aria-hidden="true">
    {%- unless s.shape == 'flat' -%}
      {%- render 'kahu-wave',
        id: section.id,
        position: wave_position,
        shape: s.shape,
        color: s.wave_color,
        custom_color: s.wave_color_custom,
        height_desktop: s.height_desktop,
        height_mobile: s.height_mobile,
        flip: s.flip
      -%}
    {%- endunless -%}
  </div>

  <div class="kahu-sep__band kahu-sep__band--bottom"></div>

  {%- for block in section.blocks -%}
    {%- liquid
      assign g = block.settings
      assign w_d = g.width_desktop
      assign scale_m = g.mobile_scale | default: 50

      # Size: "auto" scales with the screen (design widths: desktop 1440, mobile 390); "fixed" uses exact px
      if g.size_mode == 'fixed'
        assign size_d = w_d | append: 'px'
        assign size_m = g.width_mobile | append: 'px'
      else
        assign w_m = w_d | times: scale_m | divided_by: 100.0
        assign vw_d = w_d | divided_by: 14.4
        assign vw_m = w_m | divided_by: 3.9
        assign size_d = 'min(' | append: w_d | append: 'px, ' | append: vw_d | append: 'vw)'
        assign size_m = 'min(' | append: w_d | append: 'px, ' | append: vw_m | append: 'vw)'
      endif

      # Position on mobile: same as desktop, or its own
      if g.mobile_position == 'custom'
        assign x_m = g.x_mobile
        assign y_m = g.y_mobile
      else
        assign x_m = g.x_desktop
        assign y_m = g.y_desktop
      endif

      assign g_style = '--g-w-d: ' | append: size_d | append: '; --g-w-m: ' | append: size_m | append: '; --g-x-d: ' | append: g.x_desktop | append: '%; --g-y-d: ' | append: g.y_desktop | append: '%; --g-x-m: ' | append: x_m | append: '%; --g-y-m: ' | append: y_m | append: '%; --g-rot: ' | append: g.rotate | append: 'deg;'
    -%}
    <div
      class="kahu-sep__graphic kahu-sep__graphic--{{ g.layer }}{% if g.flip %} kahu-sep__graphic--flip{% endif %}{% if g.hide_mobile %} kahu-sep__graphic--hide-m{% endif %}"
      style="{{ g_style }}"
      {{ block.shopify_attributes }}
    >
      {%- if g.image -%}
        {{ g.image | image_url: width: 1200 | image_tag:
            widths: '200, 400, 600, 900, 1200',
            sizes: '(min-width: 750px) 480px, 240px',
            loading: 'lazy',
            alt: g.alt }}
      {%- else -%}
        {{ 'image' | placeholder_svg_tag: 'kahu-sep__placeholder' }}
      {%- endif -%}
    </div>
  {%- endfor -%}
</div>

{% stylesheet %}
  .kahu-sep {
    position: relative;
    z-index: 2; /* graphics may overhang the neighbouring sections */
    display: flex;
    flex-direction: column;
    background: var(--kahu-sep-bg);
    pointer-events: none;
  }

  .kahu-sep__band--top { height: var(--kahu-sep-top); background: var(--kahu-sep-top-color); }
  .kahu-sep__band--bottom { height: var(--kahu-sep-bottom); background: var(--kahu-sep-bottom-color); }
  .kahu-sep__curve { position: relative; height: var(--kahu-sep-h); }

  /* Plain space: one solid block in the curve colour */
  .kahu-sep--flat,
  .kahu-sep--flat .kahu-sep__band { background: var(--kahu-sep-fill); }

  /* Overlap: the curve (and any top band) sits on top of the bottom edge of the section above */
  .kahu-sep--overlap {
    margin-top: calc((var(--kahu-sep-h) + var(--kahu-sep-top)) * -1);
    z-index: 3;
  }

  .kahu-sep .kahu-wave { z-index: 2; }

  /* Decorative graphics */
  .kahu-sep__graphic {
    position: absolute;
    left: var(--g-x-m);
    top: var(--g-y-m);
    width: var(--g-w-m);
    translate: -50% -50%;
    rotate: var(--g-rot, 0deg);
    line-height: 0;
  }
  .kahu-sep__graphic img,
  .kahu-sep__graphic svg { display: block; width: 100%; height: auto; }
  .kahu-sep__graphic--flip img { transform: scaleX(-1); }
  .kahu-sep__graphic--front { z-index: 3; }
  .kahu-sep__graphic--back { z-index: 1; }
  .kahu-sep__placeholder { aspect-ratio: 4 / 3; background: rgb(0 0 0 / 0.08); }

  @media (max-width: 749px) {
    .kahu-sep__graphic--hide-m { display: none; }
  }

  @media (min-width: 750px) {
    .kahu-sep__graphic {
      left: var(--g-x-d);
      top: var(--g-y-d);
      width: var(--g-w-d);
    }
  }

  /* Theme editor: keep the separator selectable */
  .shopify-design-mode .kahu-sep { pointer-events: auto; }
{% endstylesheet %}

{% schema %}
{
  "name": "Kahu separator",
  "tag": "div",
  "class": "kahu-separator-section",
  "max_blocks": 8,
  "settings": [
    {
      "type": "paragraph",
      "content": "Place between two sections. Curve colour = background of the section the curve flows into. Background = the other section's colour."
    },
    {
      "type": "select",
      "id": "shape",
      "label": "Shape",
      "options": [
        { "value": "wave", "label": "Wave" },
        { "value": "tide", "label": "Double wave" },
        { "value": "arc", "label": "Arc (bulge up)" },
        { "value": "dip", "label": "Dip (curve down)" },
        { "value": "slant", "label": "Slant" },
        { "value": "flat", "label": "None (plain space)" }
      ],
      "default": "wave"
    },
    {
      "type": "select",
      "id": "direction",
      "label": "Curve direction",
      "options": [
        { "value": "up", "label": "Rises from the bottom (into section below)" },
        { "value": "down", "label": "Hangs from the top (from section above)" }
      ],
      "default": "up"
    },
    {
      "type": "select",
      "id": "mode",
      "label": "Placement",
      "options": [
        { "value": "stack", "label": "Own space between sections" },
        { "value": "overlap", "label": "Overlap the section above (e.g. over a photo)" }
      ],
      "default": "stack",
      "info": "Overlap: give the section above enough bottom spacing so its text isn't covered."
    },

    { "type": "header", "content": "Colours" },
    {
      "type": "select",
      "id": "wave_color",
      "label": "Curve colour",
      "options": [
        { "value": "cream", "label": "Cream" },
        { "value": "navy", "label": "Navy" },
        { "value": "ink", "label": "Ink" },
        { "value": "teal", "label": "Teal" },
        { "value": "yellow", "label": "Yellow" },
        { "value": "sea", "label": "Sea" },
        { "value": "white", "label": "White" },
        { "value": "coral", "label": "Coral" },
        { "value": "custom", "label": "Custom" }
      ],
      "default": "cream"
    },
    {
      "type": "color",
      "id": "wave_color_custom",
      "label": "Custom curve colour",
      "default": "#f3efe5",
      "visible_if": "{{ section.settings.wave_color == 'custom' }}"
    },
    {
      "type": "select",
      "id": "bg_color",
      "label": "Background colour",
      "options": [
        { "value": "transparent", "label": "Transparent" },
        { "value": "cream", "label": "Cream" },
        { "value": "navy", "label": "Navy" },
        { "value": "ink", "label": "Ink" },
        { "value": "teal", "label": "Teal" },
        { "value": "yellow", "label": "Yellow" },
        { "value": "sea", "label": "Sea" },
        { "value": "white", "label": "White" },
        { "value": "coral", "label": "Coral" },
        { "value": "custom", "label": "Custom" }
      ],
      "default": "teal",
      "visible_if": "{{ section.settings.mode == 'stack' and section.settings.shape != 'flat' }}"
    },
    {
      "type": "color",
      "id": "bg_color_custom",
      "label": "Custom background colour",
      "default": "#2fa4a9",
      "visible_if": "{{ section.settings.mode == 'stack' and section.settings.bg_color == 'custom' }}"
    },

    { "type": "header", "content": "Curve size" },
    { "type": "range", "id": "height_desktop", "label": "Curve height (desktop)", "min": 20, "max": 220, "step": 2, "unit": "px", "default": 90 },
    { "type": "range", "id": "height_mobile", "label": "Curve height (mobile)", "min": 10, "max": 120, "step": 2, "unit": "px", "default": 40 },
    { "type": "checkbox", "id": "flip", "label": "Mirror left/right", "default": false },

    { "type": "header", "content": "Extra space", "info": "Solid bands that extend the colour above or below the curve" },
    { "type": "range", "id": "extra_bottom_desktop", "label": "Below the curve (desktop)", "min": 0, "max": 300, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "extra_bottom_mobile", "label": "Below the curve (mobile)", "min": 0, "max": 200, "step": 2, "unit": "px", "default": 0 },
    { "type": "range", "id": "extra_top_desktop", "label": "Above the curve (desktop)", "min": 0, "max": 300, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "extra_top_mobile", "label": "Above the curve (mobile)", "min": 0, "max": 200, "step": 2, "unit": "px", "default": 0 }
  ],
  "blocks": [
    {
      "type": "graphic",
      "name": "Graphic",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image", "info": "Transparent WebP/PNG, e.g. sea turtle, manta ray" },
        { "type": "text", "id": "alt", "label": "Alt text", "info": "Leave empty if purely decorative" },
        {
          "type": "select", "id": "layer", "label": "Layer",
          "options": [ { "value": "front", "label": "In front of the curve" }, { "value": "back", "label": "Behind the curve" } ],
          "default": "front"
        },
        { "type": "range", "id": "rotate", "label": "Rotation", "min": -45, "max": 45, "step": 1, "unit": "deg", "default": 0 },
        { "type": "checkbox", "id": "flip", "label": "Mirror image", "default": false },

        {
          "type": "select", "id": "size_mode", "label": "Sizing",
          "options": [
            { "value": "auto", "label": "Auto (scales with screen width)" },
            { "value": "fixed", "label": "Fixed pixels" }
          ],
          "default": "auto"
        },

        { "type": "header", "content": "Desktop" },
        { "type": "range", "id": "width_desktop", "label": "Width", "min": 40, "max": 600, "step": 10, "unit": "px", "default": 240, "info": "Auto: size on a 1440px-wide screen; smaller screens shrink it" },
        { "type": "range", "id": "x_desktop", "label": "Horizontal position", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 25 },
        { "type": "range", "id": "y_desktop", "label": "Vertical position", "min": -50, "max": 150, "step": 2, "unit": "%", "default": 50, "info": "0% = top of the separator, 100% = bottom; beyond overhangs the next/previous section" },

        { "type": "header", "content": "Mobile" },
        { "type": "checkbox", "id": "hide_mobile", "label": "Hide on mobile", "default": false },
        { "type": "range", "id": "mobile_scale", "label": "Size on mobile", "min": 20, "max": 100, "step": 5, "unit": "%", "default": 50, "info": "% of the desktop width, then scales with the phone's width", "visible_if": "{{ block.settings.size_mode != 'fixed' }}" },
        { "type": "range", "id": "width_mobile", "label": "Width", "min": 20, "max": 400, "step": 10, "unit": "px", "default": 120, "visible_if": "{{ block.settings.size_mode == 'fixed' }}" },
        {
          "type": "select", "id": "mobile_position", "label": "Position on mobile",
          "options": [
            { "value": "same", "label": "Same as desktop" },
            { "value": "custom", "label": "Set separately" }
          ],
          "default": "same"
        },
        { "type": "range", "id": "x_mobile", "label": "Horizontal position", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 25, "visible_if": "{{ block.settings.mobile_position == 'custom' }}" },
        { "type": "range", "id": "y_mobile", "label": "Vertical position", "min": -50, "max": 150, "step": 2, "unit": "%", "default": 50, "visible_if": "{{ block.settings.mobile_position == 'custom' }}" }
      ]
    }
  ],
  "presets": [
    { "name": "Kahu separator" }
  ]
}
{% endschema %}
