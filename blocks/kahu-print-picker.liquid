  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "Shows one round swatch per print. Each swatch links to the product with that Print and the same Size as the product being viewed (product fields kahu.print and kahu.size). Prints that don't exist in that size are hidden."
    },
    {
      "type": "text",
      "id": "label",
      "label": "Heading",
      "default": "Choose your print"
