{%- doc -%}
  Kahu print picker (product page). Products are separate SKUs, no variants.
  Each product has two fields: kahu.print (one of the prints below) and kahu.size (Regular / Max / Mini).
  A swatch links to the product with that print AND the current product's size.
  The print list below must match the choices of the kahu.print product field.
{%- enddoc -%}

{%- liquid
  assign s = block.settings
  assign current = closest.product | default: product
  assign cur_print = current.metafields.kahu.print.value
  assign cur_size = current.metafields.kahu.size.value
  assign pool = s.pool | default: collections['shop-all']
  assign prints = "Anuenue - Rainbow Turtle|Hahalua - Ocean Angel|He'e - Octopus Outline|Hihimanu - Ornate Eagle Ray|Honu - Green Sea Turtle|Mano Kihikihi - Rippled Hammer Head Sharks|Hi'u - Mermaid|Mano Nui - Hammer Head Sharks|Manu - Octopus|Kukui Kai - Manta Ray|Lahui - Hawaiian Tribal|Lelewaʻa - Whale Shark|Nai'a - Dolphin|PADI Aware - Shark Close-Up|PADI Aware - Shark|Pololia - Jelly Fish" | split: "|"
-%}

<div
  class="kahu-picker kahu-picker--prints"
  style="--kp-sw: {{ s.swatch_size }}px; --kp-sw-m: {{ s.swatch_size_mobile }}px;"
  {{ block.shopify_attributes }}
>
  {%- if s.label != blank -%}
    <div class="kahu-picker__head">
      <span class="kahu-picker__label">{{ s.label | escape }}</span>
    </div>
  {%- endif -%}

  {%- if cur_size == blank and request.design_mode -%}
    <p class="kahu-picker__note">This product has no Size set (product field “Size”), so the print swatches can't be matched.</p>
  {%- endif -%}

  <ul class="kahu-swatches" role="list">
    {%- paginate pool.products by 250 -%}
      {%- for print_name in prints -%}
        {%- liquid
          assign img_key = 'swatch_' | append: forloop.index
          assign img = s[img_key]
          assign match = nil
          for p in pool.products
            if p.metafields.kahu.print.value == print_name and p.metafields.kahu.size.value == cur_size
              assign match = p
              break
            endif
          endfor
          assign is_current = false
          if print_name == cur_print
            assign is_current = true
          endif
        -%}
        {%- if match or is_current -%}
          {%- liquid
            assign href = match.url | default: current.url
            assign label = print_name | split: ' - '
          -%}
          <li>
            <a
              class="kahu-swatch{% if is_current %} is-current{% endif %}"
              href="{{ href }}"
              title="{{ print_name | escape }}"
              aria-label="{{ print_name | escape }}"
              {% if is_current %}aria-current="true"{% endif %}
            >
              {%- if img -%}
                {{ img | image_url: width: 160 | image_tag: widths: '80, 120, 160', sizes: '64px', loading: 'lazy', alt: '', class: 'kahu-swatch__img' }}
              {%- else -%}
                <span class="kahu-swatch__fallback" aria-hidden="true">{{ label.first | slice: 0, 2 }}</span>
              {%- endif -%}
            </a>
          </li>
        {%- endif -%}
      {%- endfor -%}
    {%- endpaginate -%}
  </ul>

  {%- if s.hint != blank -%}
    <p class="kahu-picker__hint">{{ s.hint | escape }}</p>
  {%- endif -%}
</div>

{% schema %}
{
