{%- doc -%}
  Kahu badge on the FIRST product image (Figma product page: "Made from recycled material",
  "Carry bag included", KAHU logo | Regular). Added as child blocks of the Product media gallery.
  Rendered once into the first image by snippets/product-media-gallery-content.liquid.
  Styles: assets/kahu-tokens.css (".kahu-badge").
{%- enddoc -%}

{%- liquid
  assign s = block.settings
  assign badge_text = s.text

  # "Product size (automatic)": Regular / Max / Mini from the product's Kahu size collection,
  # or from the "(Regular)" part of the product title. [size] inside the text is replaced too.
  if s.text_source == 'size' or s.text contains '[size]'
    assign size_name = ''
    assign p = closest.product
    for c in p.collections
      case c.handle
        when 'kahu-regular'
          assign size_name = 'Regular'
        when 'kahu-max'
          assign size_name = 'Max'
        when 'kahu-mini'
          assign size_name = 'Mini'
      endcase
      if size_name != blank
        break
      endif
    endfor
    if size_name == blank and p.title contains '('
      assign size_name = p.title | split: '(' | last | split: ')' | first | strip
    endif
    if s.text_source == 'size'
      assign badge_text = size_name
    else
      assign badge_text = s.text | replace: '[size]', size_name
    endif
  endif

  assign has_text = false
  if badge_text != blank
    assign has_text = true
  endif
  assign corner = s.position | split: '_'
-%}

{%- if s.image or has_text or request.design_mode -%}
  <div
    class="kahu-badge kahu-badge--{{ corner[0] }} kahu-badge--{{ corner[1] }} kahu-badge--{{ s.layout }}{% if s.flush %} kahu-badge--flush{% endif %}{% if s.background != blank %} kahu-badge--card{% endif %}"
    style="--kbg-img-d: {{ s.image_width_desktop }}px; --kbg-img-m: {{ s.image_width_mobile }}px; --kbg-img2-d: {{ s.image_2_width_desktop }}px; --kbg-img2-m: {{ s.image_2_width_mobile }}px; --kbg-fs-d: {{ s.text_size_desktop }}px; --kbg-fs-m: {{ s.text_size_mobile }}px; --kbg-fg: {{ s.text_color }};{% if s.background != blank %} --kbg-bg: {{ s.background }};{% endif %} --kbg-radius: {{ s.radius }}px; --kbg-r: {{ s.radius }}; --kbg-n-img-d: {{ s.image_width_desktop }}; --kbg-n-img-m: {{ s.image_width_mobile }}; --kbg-n-img2-d: {{ s.image_2_width_desktop }}; --kbg-n-img2-m: {{ s.image_2_width_mobile }}; --kbg-n-fs-d: {{ s.text_size_desktop }}; --kbg-n-fs-m: {{ s.text_size_mobile }};"
    {{ block.shopify_attributes }}
  >
    <span class="kahu-badge__main">
      {%- if s.image -%}
        {{ s.image | image_url: width: 480 | image_tag: widths: '120, 240, 360, 480', sizes: '160px', class: 'kahu-badge__img', alt: '' }}
      {%- endif -%}
      {%- if s.image and has_text and s.divider -%}
        <span class="kahu-badge__divider" aria-hidden="true"></span>
      {%- endif -%}
      {%- if has_text -%}
        <span class="kahu-badge__text kahu-badge__text--{{ s.weight }}">{{ badge_text | escape | replace: '|', '<br>' }}</span>
      {%- endif -%}
    </span>
    {%- if s.image_2 -%}
      {{ s.image_2 | image_url: width: 600 | image_tag: widths: '150, 300, 450, 600', sizes: '200px', class: 'kahu-badge__img kahu-badge__img--2', alt: '' }}
    {%- endif -%}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Badge",
  "tag": null,
  "settings": [
    { "type": "paragraph", "content": "Shows on top of the first product image, on every product using this template." },
    { "type": "image_picker", "id": "image", "label": "Icon / graphic", "info": "Transparent WebP/PNG/SVG, e.g. recycle icon, bag icon, KAHU logo" },
    {
      "type": "select", "id": "text_source", "label": "Text",
      "options": [
        { "value": "custom", "label": "Custom text" },
        { "value": "size", "label": "Product size (automatic)" }
      ],
      "default": "custom",
      "info": "Automatic shows Regular, Max or Mini for each product (from its Kahu size collection or the size in its title)"
    },
    { "type": "text", "id": "text", "label": "Custom text", "info": "Use | for a line break, e.g. Carry bag|included. [size] is replaced by Regular / Max / Mini", "visible_if": "{{ block.settings.text_source != 'size' }}" },
    {
      "type": "select", "id": "layout", "label": "Layout",
      "options": [
        { "value": "beside", "label": "Icon beside text" },
        { "value": "above", "label": "Icon above text" }
      ],
      "default": "beside"
    },
    { "type": "checkbox", "id": "divider", "label": "Line between icon and text", "default": false, "info": "e.g. KAHU | Regular" },
    {
      "type": "select", "id": "position", "label": "Position on the image",
      "options": [
        { "value": "top_left", "label": "Top left" },
        { "value": "top_right", "label": "Top right" },
        { "value": "bottom_left", "label": "Bottom left" },
        { "value": "bottom_right", "label": "Bottom right" }
      ],
      "default": "top_left",
      "info": "Badges in the same corner stack in block order"
    },
    { "type": "checkbox", "id": "flush", "label": "Stick to the image edge", "default": false, "info": "Touches the left (or right) edge of the image, with square corners on that side" },
    { "type": "image_picker", "id": "image_2", "label": "Second graphic (right side)", "info": "e.g. the ten bottles, shown to the right of the icon and text" },
    { "type": "header", "content": "Size" },
    { "type": "range", "id": "image_width_desktop", "label": "Icon width (desktop)", "min": 16, "max": 240, "step": 4, "unit": "px", "default": 40 },
    { "type": "range", "id": "image_width_mobile", "label": "Icon width (mobile)", "min": 12, "max": 160, "step": 2, "unit": "px", "default": 28 },
    { "type": "range", "id": "image_2_width_desktop", "label": "Second graphic width (desktop)", "min": 20, "max": 300, "step": 4, "unit": "px", "default": 120, "visible_if": "{{ block.settings.image_2 != blank }}" },
    { "type": "range", "id": "image_2_width_mobile", "label": "Second graphic width (mobile)", "min": 16, "max": 200, "step": 2, "unit": "px", "default": 80, "visible_if": "{{ block.settings.image_2 != blank }}" },
    { "type": "range", "id": "text_size_desktop", "label": "Text size (desktop)", "min": 10, "max": 40, "step": 1, "unit": "px", "default": 14 },
    { "type": "range", "id": "text_size_mobile", "label": "Text size (mobile)", "min": 9, "max": 30, "step": 1, "unit": "px", "default": 12 },
    {
      "type": "select", "id": "weight", "label": "Text weight",
      "options": [
        { "value": "regular", "label": "Regular" },
        { "value": "bold", "label": "Bold" }
      ],
      "default": "regular"
    },
    { "type": "header", "content": "Colours" },
    { "type": "color", "id": "text_color", "label": "Text and line colour", "default": "#ffffff" },
    { "type": "color", "id": "background", "label": "Card background", "info": "Leave empty for no card (text sits on the photo)" },
    { "type": "range", "id": "radius", "label": "Card corner radius", "min": 0, "max": 24, "step": 1, "unit": "px", "default": 8 }
  ],
  "presets": [{ "name": "Badge" }]
}
{% endschema %}
