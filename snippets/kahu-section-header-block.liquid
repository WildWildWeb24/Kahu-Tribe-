{%- doc -%}
  Renders one block of the Kahu section header (eyebrow, title, text, button, image).
  The divider block is rendered by the section itself.

  @param {object} block - The section block
{%- enddoc -%}

{%- assign t = block.type | remove_first: 'h_' -%}
{%- case t -%}
  {%- when 'eyebrow' -%}
    {%- if block.settings.text != blank -%}
      <p class="kahu-sh__eyebrow" {{ block.shopify_attributes }}>{{ block.settings.text | escape }}</p>
    {%- endif -%}

  {%- when 'title' -%}
    {%- if block.settings.text != blank -%}
      {%- assign tag = block.settings.tag | default: 'h2' -%}
      <{{ tag }} class="kahu-sh__title kahu-sh__title--{{ block.settings.size }}" {{ block.shopify_attributes }}>
        {{- block.settings.text | escape | replace: '|', '<br>' -}}
      </{{ tag }}>
    {%- endif -%}

  {%- when 'text' -%}
    {%- if block.settings.text != blank -%}
      <div class="kahu-sh__text kahu-sh__space" style="--ksh-text-w: {{ block.settings.max_width }}px; --ksh-sa-d: {{ block.settings.space_above_desktop | default: 12 }}px; --ksh-sa-m: {{ block.settings.space_above_mobile | default: 12 }}px;" {{ block.shopify_attributes }}>
        {{- block.settings.text -}}
      </div>
    {%- endif -%}

  {%- when 'button' -%}
    {%- if block.settings.label != blank -%}
      <div class="kahu-sh__button kahu-sh__space{% if block.settings.full_mobile %} kahu-sh__button--full-m{% endif %}" style="--ksh-sa-d: {{ block.settings.space_above_desktop | default: 0 }}px; --ksh-sa-m: {{ block.settings.space_above_mobile | default: 0 }}px;" {{ block.shopify_attributes }}>
        <a class="kahu-btn kahu-btn--{{ block.settings.style }}" href="{{ block.settings.link | default: routes.all_products_collection_url }}">
          <span class="kahu-btn__label">{{ block.settings.label | escape }}</span>
          {%- if block.settings.arrow -%}<span class="kahu-btn__arrow" aria-hidden="true">→</span>{%- endif -%}
        </a>
      </div>
    {%- endif -%}

  {%- when 'social' -%}
    {%- liquid
      assign platforms = 'instagram,facebook,youtube,tiktok,x,pinterest' | split: ','
      assign any_link = false
      for p in platforms
        assign key = 'link_' | append: p
        if block.settings[key] != blank
          assign any_link = true
        endif
      endfor
    -%}
    {%- if any_link or request.design_mode -%}
      <div
        class="kahu-sh__social kahu-sh__social--{{ block.settings.layout }}"
        style="--ksh-icon: {{ block.settings.icon_size }}px; --ksh-icon-gap: {{ block.settings.gap }}px;"
        {{ block.shopify_attributes }}
      >
        {%- if block.settings.label != blank -%}
          <p class="kahu-sh__social-label kahu-sh__social-label--{{ block.settings.label_style }}">{{ block.settings.label | escape }}</p>
        {%- endif -%}
        <ul class="kahu-sh__social-list" role="list">
          {%- for p in platforms -%}
            {%- assign key = 'link_' | append: p -%}
            {%- assign url = block.settings[key] -%}
            {%- if url != blank or any_link == false -%}
              <li>
                <a
                  class="kahu-sh__social-link{% if url == blank %} kahu-sh__social-link--empty{% endif %}"
                  href="{{ url | default: '#' }}"
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label="{{ p | capitalize }}"
                >
                  <svg viewBox="0 0 20 20" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg">
                    {%- render 'icon', icon: p -%}
                  </svg>
                </a>
              </li>
            {%- endif -%}
            {%- if any_link == false and forloop.index == 4 -%}{%- break -%}{%- endif -%}
          {%- endfor -%}
        </ul>
      </div>
    {%- endif -%}

  {%- when 'image' -%}
    {%- if block.settings.image -%}
      {%- capture img -%}
        {{ block.settings.image | image_url: width: 1200 | image_tag:
            widths: '200, 400, 600, 900, 1200',
            sizes: '(min-width: 750px) 600px, 400px',
            loading: 'lazy',
            class: 'kahu-sh__image',
            alt: block.settings.alt | default: block.settings.image.alt }}
      {%- endcapture -%}
      <div
        class="kahu-sh__media kahu-sh__space{% if block.settings.fill %} kahu-sh__media--fill{% endif %}"
        style="--ksh-img-w-d: {{ block.settings.width_desktop }}px; --ksh-img-w-m: {{ block.settings.width_mobile }}px; --ksh-sa-d: {{ block.settings.space_above_desktop | default: 0 }}px; --ksh-sa-m: {{ block.settings.space_above_mobile | default: 0 }}px;"
        {{ block.shopify_attributes }}
      >
        {%- if block.settings.link != blank -%}
          <a class="kahu-sh__image-link" href="{{ block.settings.link }}">{{ img }}</a>
        {%- else -%}
          {{ img }}
        {%- endif -%}
      </div>
    {%- endif -%}
  {%- when 'form' -%}
    {%- liquid
      assign fs = block.settings
      assign fid = 'KahuForm-' | append: block.id
      assign subjects = fs.subjects | newline_to_br | split: '<br />'
    -%}
    <div
      class="kahu-form kahu-sh__space"
      style="--kf-max: {{ fs.max_width }}px; --ksh-sa-d: {{ fs.space_above_desktop }}px; --ksh-sa-m: {{ fs.space_above_mobile }}px;"
      {{ block.shopify_attributes }}
    >
      {%- form 'contact', id: fid, class: 'kahu-form__form' -%}
        {%- if form.posted_successfully? -%}
          <p class="kahu-form__msg kahu-form__msg--ok" role="status" tabindex="-1" autofocus>{{ fs.success | escape }}</p>
        {%- else -%}
          {%- if form.errors -%}
            <div class="kahu-form__msg kahu-form__msg--error" role="alert" tabindex="-1" autofocus>
              {{ form.errors | default_errors }}
            </div>
          {%- endif -%}
          {%- if fs.tag != blank -%}<input type="hidden" name="contact[tags]" value="{{ fs.tag | escape }}">{%- endif -%}

          <div class="kahu-form__field kahu-form__field--half">
            <label for="{{ fid }}-name">{{ fs.name_label | escape }}</label>
            <input id="{{ fid }}-name" type="text" name="contact[name]" autocomplete="name" required value="{{ form.name }}">
          </div>
          <div class="kahu-form__field">
            <label for="{{ fid }}-email">{{ fs.email_label | escape }}</label>
            <input id="{{ fid }}-email" type="email" name="contact[email]" autocomplete="email" required spellcheck="false" autocapitalize="off" value="{{ form.email }}">
          </div>
          {%- if fs.company_label != blank -%}
            <div class="kahu-form__field">
              <label for="{{ fid }}-company">{{ fs.company_label | escape }}</label>
              <input id="{{ fid }}-company" type="text" name="contact[Company]" autocomplete="organization">
            </div>
          {%- endif -%}
          {%- if fs.phone_label != blank -%}
            <div class="kahu-form__field">
              <label for="{{ fid }}-phone">{{ fs.phone_label | escape }} <span class="kahu-form__opt">(Optional)</span></label>
              <input id="{{ fid }}-phone" type="tel" name="contact[phone]" autocomplete="tel" pattern="[0-9\-\+\s\(\)]*" value="{{ form.phone }}">
            </div>
          {%- endif -%}
          {%- if fs.subject_label != blank -%}
            <div class="kahu-form__field">
              <label for="{{ fid }}-subject">{{ fs.subject_label | escape }}</label>
              <div class="kahu-form__select">
                <select id="{{ fid }}-subject" name="contact[Subject]">
                  <option value="">{{ fs.subject_placeholder | escape }}</option>
                  {%- for opt in subjects -%}
                    {%- assign o = opt | strip -%}
                    {%- if o != blank -%}<option value="{{ o | escape }}">{{ o | escape }}</option>{%- endif -%}
                  {%- endfor -%}
                </select>
              </div>
            </div>
          {%- endif -%}
          <div class="kahu-form__field">
            <label for="{{ fid }}-body">{{ fs.message_label | escape }}</label>
            <textarea id="{{ fid }}-body" name="contact[body]" rows="6" required placeholder="{{ fs.message_placeholder | escape }}">{{ form.body }}</textarea>
          </div>
          <div class="kahu-form__actions">
            <button type="submit" class="kahu-btn kahu-btn--{{ fs.button_style }}"><span class="kahu-btn__label">{{ fs.button_label | escape }}</span></button>
          </div>
        {%- endif -%}
      {%- endform -%}
    </div>
{%- endcase -%}
