{%- doc -%}
  Renders one block of the Kahu section header (eyebrow, title, text, button, image).
  The divider block is rendered by the section itself.

  @param {object} block - The section block
{%- enddoc -%}

{%- assign t = block.type | remove_first: 'h_' -%}
{%- case t -%}
  {%- when 'eyebrow' -%}
    {%- if block.settings.text != blank -%}
      <p class="kahu-sh__eyebrow" {{ block.shopify_attributes }}>{{ block.settings.text | escape }}</p>
    {%- endif -%}

  {%- when 'title' -%}
    {%- if block.settings.text != blank -%}
      {%- assign tag = block.settings.tag | default: 'h2' -%}
      <{{ tag }} class="kahu-sh__title kahu-sh__title--{{ block.settings.size }}" {{ block.shopify_attributes }}>
        {{- block.settings.text | escape | replace: '|', '<br>' -}}
      </{{ tag }}>
    {%- endif -%}

  {%- when 'text' -%}
    {%- if block.settings.text != blank -%}
      <div class="kahu-sh__text kahu-sh__space" style="--ksh-text-w: {{ block.settings.max_width }}px; --ksh-sa-d: {{ block.settings.space_above_desktop | default: 12 }}px; --ksh-sa-m: {{ block.settings.space_above_mobile | default: 12 }}px;" {{ block.shopify_attributes }}>
        {{- block.settings.text -}}
      </div>
    {%- endif -%}

  {%- when 'button' -%}
    {%- if block.settings.label != blank -%}
      <div class="kahu-sh__button kahu-sh__space{% if block.settings.full_mobile %} kahu-sh__button--full-m{% endif %}" style="--ksh-sa-d: {{ block.settings.space_above_desktop | default: 0 }}px; --ksh-sa-m: {{ block.settings.space_above_mobile | default: 0 }}px;" {{ block.shopify_attributes }}>
        <a class="kahu-btn kahu-btn--{{ block.settings.style }}" href="{{ block.settings.link | default: routes.all_products_collection_url }}">
          <span class="kahu-btn__label">{{ block.settings.label | escape }}</span>
          {%- if block.settings.arrow -%}<span class="kahu-btn__arrow" aria-hidden="true">→</span>{%- endif -%}
        </a>
      </div>
    {%- endif -%}

  {%- when 'social' -%}
    {%- liquid
      assign platforms = 'instagram,facebook,youtube,tiktok,x,pinterest' | split: ','
      assign any_link = false
      for p in platforms
        assign key = 'link_' | append: p
        if block.settings[key] != blank
          assign any_link = true
        endif
      endfor
    -%}
    {%- if any_link or request.design_mode -%}
      <div
        class="kahu-sh__social kahu-sh__social--{{ block.settings.layout }}"
        style="--ksh-icon: {{ block.settings.icon_size }}px; --ksh-icon-gap: {{ block.settings.gap }}px;"
        {{ block.shopify_attributes }}
      >
        {%- if block.settings.label != blank -%}
          <p class="kahu-sh__social-label kahu-sh__social-label--{{ block.settings.label_style }}">{{ block.settings.label | escape }}</p>
        {%- endif -%}
        <ul class="kahu-sh__social-list" role="list">
          {%- for p in platforms -%}
            {%- assign key = 'link_' | append: p -%}
            {%- assign url = block.settings[key] -%}
            {%- if url != blank or any_link == false -%}
              <li>
                <a
                  class="kahu-sh__social-link{% if url == blank %} kahu-sh__social-link--empty{% endif %}"
                  href="{{ url | default: '#' }}"
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label="{{ p | capitalize }}"
                >
                  <svg viewBox="0 0 20 20" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg">
                    {%- render 'icon', icon: p -%}
                  </svg>
                </a>
              </li>
            {%- endif -%}
            {%- if any_link == false and forloop.index == 4 -%}{%- break -%}{%- endif -%}
          {%- endfor -%}
        </ul>
      </div>
    {%- endif -%}

  {%- when 'image' -%}
    {%- if block.settings.image -%}
      {%- capture img -%}
        {{ block.settings.image | image_url: width: 1200 | image_tag:
            widths: '200, 400, 600, 900, 1200',
            sizes: '(min-width: 750px) 600px, 400px',
            loading: 'lazy',
            class: 'kahu-sh__image',
            alt: block.settings.alt | default: block.settings.image.alt }}
      {%- endcapture -%}
      <div
        class="kahu-sh__media kahu-sh__space"
        style="--ksh-img-w-d: {{ block.settings.width_desktop }}px; --ksh-img-w-m: {{ block.settings.width_mobile }}px; --ksh-sa-d: {{ block.settings.space_above_desktop | default: 0 }}px; --ksh-sa-m: {{ block.settings.space_above_mobile | default: 0 }}px;"
        {{ block.shopify_attributes }}
      >
        {%- if block.settings.link != blank -%}
          <a class="kahu-sh__image-link" href="{{ block.settings.link }}">{{ img }}</a>
        {%- else -%}
          {{ img }}
        {%- endif -%}
      </div>
    {%- endif -%}
{%- endcase -%}
